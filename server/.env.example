# Railway injects DATABASE_URL automatically once you attach a Postgres
# plugin to this service — you normally don't set it by hand there.
# For local development, point it at any Postgres you have running:
DATABASE_URL=postgres://user:password@localhost:5432/aquaconnect

# Any long random string — used to sign login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — falls back to a shared demo key baked into src/lib/nifs.js
# (same default D:\202609\index.mjs used) if unset.
NIFS_API_KEY=

# Password seeded for the demo login (leedonggil@haegang.kr) by `npm run seed`.
SEED_DEMO_PASSWORD=demo1234

PORT=8080
